# Copy to `.env` and adjust. `.env` is gitignored; this file is the contract.
# Anything here overrides the matching ${...} placeholder in config/config.yaml.

# ---------------------------------------------------------------- MongoDB
MONGO_ROOT_USER=wrc
MONGO_ROOT_PASSWORD=wrc_password
MONGO_HOST_PORT=27017
MONGO_DATABASE=wrc
MONGO_URI=mongodb://wrc:wrc_password@localhost:27017/?authSource=admin

# ---------------------------------------------------------------- MinIO / S3
S3_HOST_PORT=9000
S3_CONSOLE_HOST_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_LANDING_BUCKET=decisions-landing
S3_CURATED_BUCKET=decisions-curated

# ---------------------------------------------------------------- Pipeline run
# Inclusive date range and the partition granularity used to walk it.
RUN_START_DATE=2024-01-01
RUN_END_DATE=2025-01-01
PARTITION_SIZE=weekly

# ---------------------------------------------------------------- Politeness
SCRAPY_CONCURRENT_REQUESTS=16
SCRAPY_CONCURRENT_PER_DOMAIN=8
SCRAPY_DOWNLOAD_DELAY=0.25
SCRAPY_AUTOTHROTTLE_ENABLED=true
SCRAPY_AUTOTHROTTLE_TARGET_CONCURRENCY=4.0
SCRAPY_RETRY_TIMES=4
SCRAPY_DOWNLOAD_TIMEOUT=45

# ---------------------------------------------------------------- Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.jsonl
